+
+struct perf_stat { uint64_t calls = 0, ns = 0, bytes = 0; };
+static std::map<std::pair<std::string, std::string>, perf_stat> perf_stats;
+static std::mutex perf_mutex;
+static std::string perf_phase_name = "setup";
+bool ggml_perf_enabled() { static bool enabled = getenv("GGML_PERF_LOG") != nullptr; return enabled; }
+const char * ggml_perf_current_phase() { return perf_phase_name.c_str(); }
+void ggml_perf_phase(const char * phase) { perf_phase_name = phase; }
+void ggml_perf_record(const char * category, uint64_t ns, uint64_t bytes) {
+    if (!ggml_perf_enabled()) { return; }
+    std::lock_guard<std::mutex> lock(perf_mutex);
+    auto & stat = perf_stats[{perf_phase_name, category}];
+    stat.calls++; stat.ns += ns; stat.bytes += bytes;
+}
+void ggml_perf_dump(const char * path) {
+    FILE * file = fopen(path, "w");
+    if (!file) { return; }
+    fprintf(file, "[\n");
+    bool first = true;
+    for (const auto & item : perf_stats) {
+        fprintf(file, "%s{\"phase\":\"%s\",\"category\":\"%s\",\"calls\":%llu,\"ns\":%llu,\"bytes\":%llu}",
+            first ? "" : ",\n", item.first.first.c_str(), item.first.second.c_str(),
+            (unsigned long long)item.second.calls, (unsigned long long)item.second.ns, (unsigned long long)item.second.bytes);
+        first = false;
+    }
+    fprintf(file, "\n]\n"); fclose(file);
+}
