+}
+
+cl_int ggml_perf_clEnqueueNDRangeKernel(cl_command_queue queue, cl_kernel kernel, cl_uint dimensions, const size_t * offset, const size_t * global, const size_t * local, cl_uint n, const cl_event * wait, cl_event * event) {
+    const bool trace = getenv("GGML_PERF_KERNEL_TRACE") != nullptr;
+    if (!ggml_perf_enabled() && !trace) { return ggml_opencl_sphal.clEnqueueNDRangeKernel(queue, kernel, dimensions, offset, global, local, n, wait, event); }
+    char name[256] = {};
+    if (trace) {
+        ggml_opencl_sphal.clGetKernelInfo(kernel, CL_KERNEL_FUNCTION_NAME, sizeof(name), name, nullptr);
+        fprintf(stderr, "KERNEL_BEGIN %s dim=%u", name, dimensions);
+        for (cl_uint i = 0; i < dimensions; ++i) fprintf(stderr, " g%u=%zu l%u=%zu", i, global[i], i, local ? local[i] : 0);
+        fprintf(stderr, "\n");
+        fflush(stderr);
+    }
+    auto start = std::chrono::steady_clock::now();
+    auto result = ggml_opencl_sphal.clEnqueueNDRangeKernel(queue, kernel, dimensions, offset, global, local, n, wait, event);
+    if (trace) {
+        cl_int finish = result == CL_SUCCESS ? ggml_opencl_sphal.clFinish(queue) : result;
+        fprintf(stderr, "KERNEL_END %s enqueue=%d finish=%d\n", name, result, finish);
+        if (finish != CL_SUCCESS) result = finish;
+        fflush(stderr);
+    }
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
+    ggml_perf_record("clEnqueueNDRangeKernel", ns, 0);
+    return result;
+}
