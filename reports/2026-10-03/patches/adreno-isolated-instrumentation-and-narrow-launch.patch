+cl_int ggml_perf_clSetKernelArg(cl_kernel kernel, cl_uint index, size_t size, const void * value) {
+    const bool trace = getenv("GGML_PERF_KERNEL_TRACE") != nullptr;
+    if (!ggml_perf_enabled() && !trace) { return ggml_opencl_sphal.clSetKernelArg(kernel, index, size, value); }
+    if (trace) {
+        char name[256] = {};
+        ggml_opencl_sphal.clGetKernelInfo(kernel, CL_KERNEL_FUNCTION_NAME, sizeof(name), name, nullptr);
+        unsigned long long scalar = 0;
+        if (value && size <= sizeof(scalar)) memcpy(&scalar, value, size);
+        fprintf(stderr, "KERNEL_ARG %s index=%u bytes=%zu value=%llx local=%d\n", name, index, size, scalar, value == nullptr);
+        fflush(stderr);
