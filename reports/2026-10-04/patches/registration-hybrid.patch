+        }
+        ggml_backend_buffer_ptr host(ggml_backend_alloc_ctx_tensors_from_buft(pimpl->perf_shadow_ctx.get(), ggml_backend_cpu_buffer_type()));
+        if (!host) throw std::runtime_error("hybrid CPU weight allocation failed");
+        ggml_backend_buffer_set_usage(host.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        pimpl->perf_shadow_buffers.emplace_back(std::move(host));
+        for (const auto & pair : pimpl->perf_shadow_pairs) {
+            ggml_backend_tensor_copy(pair.first, pair.second);
+            stats.weight_copy_bytes += ggml_nbytes(pair.first);
+        }
+    }
+    for (const auto & pair : pimpl->perf_shadow_pairs) {
+        stats.cpu_shadow_weight_bytes += ggml_nbytes(pair.first);
+        pair.first->buffer = pair.second->buffer;
+        pair.first->data = pair.second->data;
+        pair.first->extra = pair.second->extra;
+    }
+    // Preserve view identities while rebasing them to the CPU representation.
+    for (const auto & item : pimpl->ctxs_bufs) {
+        for (auto * t = ggml_get_first_tensor(item.first.get()); t; t = ggml_get_next_tensor(item.first.get(), t)) {
+            if (t->view_src && ggml_backend_buffer_is_host(t->view_src->buffer)) {
+                t->buffer = t->view_src->buffer; t->extra = nullptr;
+                t->data = (char *) t->view_src->data + t->view_offs;
+            }
+        }
+    }
+    if (drop_gpu) {
+        for (auto & item : pimpl->ctxs_bufs) {
+            auto & buffers = item.second;
+            buffers.erase(std::remove_if(buffers.begin(), buffers.end(), [&](const ggml_backend_buffer_ptr & buf) {
+                if (!perf_buffer_is_gpu(buf.get())) return false;
+                stats.gpu_weight_bytes_released += ggml_backend_buffer_get_size(buf.get());
+                return true;
+            }), buffers.end());
+        }
+    }
+    LLAMA_LOG_INFO("HYBRID: CPU weight references installed; readback %.2f MiB, shadow weights %.2f MiB, GPU weights released %.2f MiB\n",
+            stats.weight_copy_bytes/1048576.0, stats.cpu_shadow_weight_bytes/1048576.0, stats.gpu_weight_bytes_released/1048576.0);
+}
