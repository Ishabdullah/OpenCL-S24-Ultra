+void ggml_hexagon_session::prepare_registration_window(const htp_opnode & node) {
+    if (!opt_registration_window) return;
+    if (mdev.count > 1 || !mdev.sessions.empty() || !virt_peers.empty() || !phys_peers.empty()) {
+        throw std::runtime_error("registration window prototype supports one session only");
+    }
+    std::unordered_set<ggml_hexagon_shared_buffer *> needed;
+    auto collect = [&](const ggml_tensor * t) {
+        if (!t) return;
+        auto sbuf = static_cast<ggml_hexagon_shared_buffer *>(t->buffer->context);
+        if (sbuf->sess != this) throw std::runtime_error("registration window requires owned buffers");
+        needed.insert(sbuf);
+    };
+    for (auto t : node.get_inputs()) collect(t);
+    for (auto t : node.get_outputs()) collect(t);
+    size_t bytes = 0;
+    for (auto sbuf : registered_buffers) bytes += sbuf->size();
+    for (auto sbuf : needed) if (!sbuf->mapped) bytes += sbuf->size();
+    if (bytes <= opt_registration_window) return;
+
+    // All queued references must finish before idle weight mappings are removed.
+    flush_sync();
+    if (last_error > HTP_STATUS_OK) throw std::runtime_error("DSP error before registration eviction");
+    auto start = std::chrono::steady_clock::now();
+    std::vector<ggml_hexagon_shared_buffer *> candidates;
+    for (auto sbuf : registered_buffers) {
+        if (sbuf->weight && !sbuf->pinned && sbuf->mem && sbuf->mem->mapped_clones.empty() && !needed.count(sbuf)) candidates.push_back(sbuf);
+    }
+    std::sort(candidates.begin(), candidates.end(), [](auto a, auto b) { return a->fd() < b->fd(); });
+    size_t evicted = 0;
+    for (auto sbuf : candidates) {
+        if (bytes <= opt_registration_window) break;
+        size_t size = sbuf->size();
+        sbuf->unmap_checked();
+        bytes -= size;
+        evicted++;
+    }
+    if (bytes > opt_registration_window) throw std::runtime_error("current operation and non-evictable buffers exceed registration window");
+    double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now()-start).count();
+    HEX_VERBOSE("ggml-hex: registration-window evicted %zu buffers planned bytes %zu limit %zu unmap_ms %.3f\n", evicted, bytes, opt_registration_window, ms);
+}
