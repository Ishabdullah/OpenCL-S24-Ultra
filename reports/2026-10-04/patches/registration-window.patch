+// Diagnostic only: retain physical storage while dropping an idle mapping.
+static int ggml_hexagon_probe_unmap(ggml_backend_t backend, ggml_backend_buffer_t buffer) {
+    if (!backend || !buffer || buffer->iface.free_buffer != ggml_backend_hexagon_buffer_free_buffer) return -1;
+    auto sess = static_cast<ggml_hexagon_session *>(backend->context);
+    auto sbuf = static_cast<ggml_hexagon_shared_buffer *>(buffer->context);
+    if (sbuf->sess != sess || sbuf->pinned || !sbuf->mem || !sbuf->mem->mapped_clones.empty() || !sess->mdev.sessions.empty()) return -2;
+    sess->flush_sync();
+    if (!sbuf->mapped) return 0;
+    int err = htp_iface_munmap(sess->handle, sbuf->fd());
+    if (err != 0) return err;
+    err = fastrpc_munmap(sess->domain_id, sbuf->fd(), (void *) sbuf->base(), sbuf->size());
+    if (err != 0) return err;
+    sbuf->mapped = false;
+    sess->registered_buffers.erase(sbuf);
+    HEX_VERBOSE("ggml-hex: diagnostic retained-storage unmap fd %d size %zu\n", sbuf->fd(), sbuf->size());
+    return 0;
+}
