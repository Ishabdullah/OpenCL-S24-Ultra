diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 1d0554f..adac481 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -14,6 +14,51 @@
 #include <stdexcept>
 #include <unordered_map>
 
+uint64_t llama_kv_cache::perf_migrate_cpu() {
+    uint64_t bytes = 0;
+    for (auto & item : ctxs_bufs) {
+        if (ggml_backend_buffer_is_host(item.second.get())) continue;
+        // Save source descriptors while the old driver buffer remains alive.
+        std::vector<std::pair<ggml_tensor *, ggml_tensor>> sources;
+        for (auto * t = ggml_get_first_tensor(item.first.get()); t; t = ggml_get_next_tensor(item.first.get(), t)) {
+            if (!t->view_src) sources.emplace_back(t, *t);
+        }
+        size_t capacity = 0;
+        for (const auto & pair : sources) capacity += ggml_nbytes(&pair.second);
+        FILE * mem = fopen("/proc/meminfo", "r"); size_t available = 0; char line[256];
+        if (mem) { while (fgets(line, sizeof(line), mem)) { if (sscanf(line, "MemAvailable: %zu kB", &available) == 1) break; } fclose(mem); }
+        if (!available || capacity + 512ULL*1024*1024 > available*1024ULL) {
+            throw std::runtime_error("hybrid KV migration admission guard: insufficient MemAvailable for temporary cache duplication");
+        }
+        for (auto * t = ggml_get_first_tensor(item.first.get()); t; t = ggml_get_next_tensor(item.first.get(), t)) {
+            t->data = nullptr; t->buffer = nullptr; t->extra = nullptr;
+        }
+        ggml_backend_buffer_ptr host(ggml_backend_alloc_ctx_tensors_from_buft(item.first.get(), ggml_backend_cpu_buffer_type()));
+        if (!host) throw std::runtime_error("hybrid CPU KV allocation failed");
+        for (const auto & pair : sources) {
+            ggml_backend_tensor_copy(&pair.second, pair.first);
+            bytes += ggml_nbytes(&pair.second);
+            const char * check = getenv("GGML_PERF_HYBRID_CHECK_COPY");
+            if (check && strcmp(check, "1") == 0) {
+                std::vector<char> chunk(1024*1024);
+                const size_t size = ggml_nbytes(&pair.second);
+                for (size_t offset = 0; offset < size; offset += chunk.size()) {
+                    size_t n = std::min(chunk.size(), size - offset);
+                    ggml_backend_tensor_get(&pair.second, chunk.data(), offset, n);
+                    if (memcmp(chunk.data(), (char *) pair.first->data + offset, n)) {
+                        throw std::runtime_error("hybrid KV copy validation mismatch");
+                    }
+                }
+                LLAMA_LOG_INFO("HYBRID: KV byte copy verified: %s, %zu bytes (diagnostic timing only)\n", pair.first->name, size);
+            }
+        }
+        // Free driver storage only after all base tensors and views are valid.
+        item.second = std::move(host);
+    }
+    LLAMA_LOG_INFO("HYBRID: copied %.2f MiB allocated KV to CPU; cache cells, positions and sequence metadata retained\n", bytes/1048576.0);
+    return bytes;
+}
