+void llama_context::perf_switch_cpu(bool drop_gpu_weights, llama_perf_handoff_stats & stats) {
+    if (perf_cpu_only) throw std::runtime_error("hybrid handoff is one-way and already completed");
+    auto * kv = dynamic_cast<llama_kv_cache *>(memory.get());
+    auto * hyb = dynamic_cast<llama_memory_hybrid *>(memory.get());
+    const bool plain_ok  = kv && (model.arch == LLM_ARCH_QWEN2 || model.arch == LLM_ARCH_QWEN3);
+    const bool hybrid_ok = hyb && model.arch == LLM_ARCH_QWEN3NEXT;
+    if (!plain_ok && !hybrid_ok) {
+        throw std::runtime_error("hybrid prototype supports plain Qwen2/Qwen3 KV, or Qwen3Next hybrid (attn+recurrent) memory, only");
+    }
+    const int64_t start = ggml_time_us();
+    synchronize();
+    for (auto & res : gf_res_prev) res.reset();
+    gf_res_reserve.reset(); gf_res_prev_active = nullptr;
+    perf_cpu_only = true;
+    cparams.op_offload = false; cparams.pipeline_parallel = false; cparams.offload_kqv = false;
+    backend_ptrs = {backend_cpu};
+    backend_buft = {ggml_backend_get_default_buffer_type(backend_cpu)};
+    backend_buf_exp_size = {0};
+    sched.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(), 1,
+            graph_max_nodes(std::min(cparams.n_ctx, cparams.n_ubatch)), false, false));
+    const int64_t weights_start = ggml_time_us();
+    const_cast<llama_model &>(model).perf_switch_weights_cpu(drop_gpu_weights, stats);
+    stats.weights_ms = (ggml_time_us() - weights_start)/1000.0;
+    const int64_t kv_start = ggml_time_us();
+    if (plain_ok) {
+        stats.kv_copy_bytes = kv->perf_migrate_cpu();
+    } else {
+        stats.kv_copy_bytes  = hyb->get_mem_attn()->perf_migrate_cpu();
+        stats.kv_copy_bytes += hyb->get_mem_recr()->perf_migrate_cpu();
+    }
+    stats.kv_ms = (ggml_time_us() - kv_start)/1000.0;
+    const int64_t sched_start = ggml_time_us();
+    sched_need_reserve = true;
+    sched_reserve();
+    stats.scheduler_ms = (ggml_time_us() - sched_start)/1000.0;
+    stats.total_ms = (ggml_time_us() - start)/1000.0;
+    LLAMA_LOG_INFO("HYBRID: handoff complete in %.3f ms; scheduler backends=%d CPU-only; same model/context, no prompt replay\n",
+            stats.total_ms, ggml_backend_sched_get_n_backends(sched.get()));
+}
+
+int llama_perf_switch_to_cpu(llama_context * ctx, bool drop_gpu_weights, llama_perf_handoff_stats * stats) {
+    if (!ctx || !stats) return -1;
+    *stats = {};
+    try { ctx->perf_switch_cpu(drop_gpu_weights, *stats); return 0; }
+    catch (const std::exception & e) { LLAMA_LOG_ERROR("HYBRID: handoff failed: %s\n", e.what()); return -1; }
+}
