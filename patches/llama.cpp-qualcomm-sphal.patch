diff --git a/ggml/src/ggml-opencl/opencl-sphal.cpp b/ggml/src/ggml-opencl/opencl-sphal.cpp
new file mode 100644
index 0000000..a3dc94e
--- /dev/null
+++ b/ggml/src/ggml-opencl/opencl-sphal.cpp
@@ -0,0 +1,81 @@
+#define CL_TARGET_OPENCL_VERSION GGML_OPENCL_TARGET_VERSION
+#define CL_USE_DEPRECATED_OPENCL_1_2_APIS
+#define GGML_OPENCL_SPHAL_NO_REMAP
+
+#include "opencl-sphal.h"
+#include "ggml-impl.h"
+
+#include <android/dlext.h>
+#include <dlfcn.h>
+#include <mutex>
+
+ggml_opencl_sphal_dispatch ggml_opencl_sphal = {};
+
+static bool ggml_opencl_sphal_load() {
+    using get_namespace_fn = android_namespace_t * (*)(const char *);
+    using dlopen_ext_fn = void * (*)(const char *, int, const android_dlextinfo *);
+
+    auto get_ns = reinterpret_cast<get_namespace_fn>(dlsym(RTLD_DEFAULT, "__loader_android_get_exported_namespace"));
+    auto open_ext = reinterpret_cast<dlopen_ext_fn>(dlsym(RTLD_DEFAULT, "android_dlopen_ext"));
+    if (!get_ns || !open_ext) {
+        GGML_LOG_ERROR("ggml_opencl: Android namespace API unavailable\n");
+        return false;
+    }
+
+    android_namespace_t * sphal = get_ns("sphal");
+    if (!sphal) {
+        GGML_LOG_ERROR("ggml_opencl: Android sphal namespace unavailable\n");
+        return false;
+    }
+
+    android_dlextinfo ext = {};
+    ext.flags = ANDROID_DLEXT_USE_NAMESPACE;
+    ext.library_namespace = sphal;
+
+    // Keep both handles for process lifetime; dispatch pointers depend on them.
+    void * driver = open_ext("/vendor/lib64/libOpenCL_adreno.so", RTLD_NOW | RTLD_LOCAL, &ext);
+    if (!driver) {
+        GGML_LOG_ERROR("ggml_opencl: Adreno driver load failed: %s\n", dlerror());
+        return false;
+    }
+
+    using init_driver_fn = int (*)(void);
+    auto init_driver = reinterpret_cast<init_driver_fn>(dlsym(driver, "InitOpenCLDriver"));
+    if (!init_driver) {
+        GGML_LOG_ERROR("ggml_opencl: InitOpenCLDriver unavailable: %s\n", dlerror());
+        return false;
+    }
+
+    // Qualcomm initialization must precede loading its OpenCL ICD.
+    const int rc = init_driver();
+    GGML_LOG_INFO("ggml_opencl: sphal InitOpenCLDriver() = %d\n", rc);
+    if (rc != 0) {
+        GGML_LOG_ERROR("ggml_opencl: Adreno initialization failed: %d\n", rc);
+        return false;
+    }
+
+    void * loader = open_ext("/vendor/lib64/libOpenCL.so", RTLD_NOW | RTLD_LOCAL, &ext);
+    if (!loader) {
+        GGML_LOG_ERROR("ggml_opencl: Qualcomm OpenCL loader failed: %s\n", dlerror());
+        return false;
+    }
+
+    ggml_opencl_sphal_dispatch dispatch = {};
+#define GGML_OPENCL_SPHAL_RESOLVE(name) \
+    dispatch.name = reinterpret_cast<decltype(dispatch.name)>(dlsym(loader, #name)); \
+    if (!dispatch.name) { \
+        GGML_LOG_ERROR("ggml_opencl: Qualcomm OpenCL symbol %s unavailable: %s\n", #name, dlerror()); \
+        return false; \
+    }
+    GGML_OPENCL_SPHAL_FUNCTIONS(GGML_OPENCL_SPHAL_RESOLVE)
+#undef GGML_OPENCL_SPHAL_RESOLVE
+    ggml_opencl_sphal = dispatch;
+    return true;
+}
+
+bool ggml_opencl_sphal_init() {
+    static std::once_flag once;
+    static bool ready = false;
+    std::call_once(once, [] { ready = ggml_opencl_sphal_load(); });
+    return ready;
+}
