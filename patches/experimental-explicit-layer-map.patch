+void llama_model::perf_prepare_cpu_shadows(llama_model_loader & ml) {
+    if (!ml.use_mmap || ml.mappings.empty()) {
+        throw std::runtime_error("hybrid mapped shadows require explicit MMAP loading");
+    }
+    size_t count = 0;
+    for (const auto & item : pimpl->ctxs_bufs) {
+        for (auto * t = ggml_get_first_tensor(item.first.get()); t; t = ggml_get_next_tensor(item.first.get(), t)) {
+            if (t->buffer && perf_buffer_is_gpu(t->buffer) && !t->view_src) count++;
+        }
+    }
+    ggml_init_params ip { count * ggml_tensor_overhead() + 4096, nullptr, true };
+    pimpl->perf_shadow_ctx.reset(ggml_init(ip));
+    if (!pimpl->perf_shadow_ctx) throw std::runtime_error("hybrid CPU shadow metadata allocation failed");
+    for (const auto & mapping : ml.mappings) {
+        ggml_backend_buffer_ptr buf(ggml_backend_cpu_buffer_from_ptr(mapping->addr(), mapping->size()));
+        ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        pimpl->perf_shadow_buffers.emplace_back(std::move(buf));
+    }
+    uint64_t bytes = 0;
+    for (const auto & item : pimpl->ctxs_bufs) {
+        for (auto * t = ggml_get_first_tensor(item.first.get()); t; t = ggml_get_next_tensor(item.first.get(), t)) {
+            if (!t->buffer || !perf_buffer_is_gpu(t->buffer) || t->view_src) continue;
+            const auto & w = ml.require_weight(t->name);
+            if (t->type != w.tensor->type || memcmp(t->ne, w.tensor->ne, sizeof(t->ne)) ||
+                    memcmp(t->nb, w.tensor->nb, sizeof(t->nb))) throw std::runtime_error("hybrid shadow GGUF layout mismatch");
+            auto * shadow = ggml_dup_tensor(pimpl->perf_shadow_ctx.get(), t);
+            ggml_set_name(shadow, t->name);
+            void * addr = (char *) ml.mappings.at(w.idx)->addr() + w.offs;
+            if (ggml_backend_tensor_alloc(pimpl->perf_shadow_buffers.at(w.idx).get(), shadow, addr) != GGML_STATUS_SUCCESS) {
+                throw std::runtime_error("hybrid CPU mapped tensor initialization failed");
+            }
+            pimpl->perf_shadow_pairs.emplace_back(t, shadow);
+            bytes += ggml_nbytes(t);
+        }
+    }
+    pimpl->perf_shadow_mapped = true;
+    LLAMA_LOG_INFO("HYBRID: retained CPU mapped shadows: %zu tensors, %.2f MiB logical weights (distinct from GPU storage)\n",
+            count, bytes / 1048576.0);
+}
+
+void llama_model::perf_switch_weights_cpu(bool drop_gpu, llama_perf_handoff_stats & stats) {
+    if (!pimpl->perf_shadow_mapped) {
+        std::vector<ggml_tensor *> targets;
+        size_t bytes = 0;
+        for (const auto & item : pimpl->ctxs_bufs) {
+            for (auto * t = ggml_get_first_tensor(item.first.get()); t; t = ggml_get_next_tensor(item.first.get(), t)) {
+                if (t->buffer && perf_buffer_is_gpu(t->buffer) && !t->view_src) {
+                    targets.push_back(t); bytes += ggml_nbytes(t);
+                }
+            }
+        }
+        if (targets.empty()) return;
+        // Refuse unsafe eager weight duplication. A guard is not an OOM result.
+        FILE * mem = fopen("/proc/meminfo", "r");
+        size_t available = 0; char line[256];
+        if (mem) { while (fgets(line, sizeof(line), mem)) { if (sscanf(line, "MemAvailable: %zu kB", &available) == 1) break; } fclose(mem); }
+        if (!available || bytes + 512ULL*1024*1024 > available*1024ULL) {
+            throw std::runtime_error("hybrid weight-readback admission guard: insufficient MemAvailable; use retained mmap shadows");
+        }
+        ggml_init_params ip { targets.size() * ggml_tensor_overhead() + 4096, nullptr, true };
+        pimpl->perf_shadow_ctx.reset(ggml_init(ip));
+        if (!pimpl->perf_shadow_ctx) throw std::runtime_error("hybrid CPU shadow metadata allocation failed");
+        for (auto * t : targets) {
+            auto * shadow = ggml_dup_tensor(pimpl->perf_shadow_ctx.get(), t);
+            ggml_set_name(shadow, t->name);
+            pimpl->perf_shadow_pairs.emplace_back(t, shadow);
+        }
+        ggml_backend_buffer_ptr host(ggml_backend_alloc_ctx_tensors_from_buft(pimpl->perf_shadow_ctx.get(), ggml_backend_cpu_buffer_type()));
+        if (!host) throw std::runtime_error("hybrid CPU weight allocation failed");
+        ggml_backend_buffer_set_usage(host.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        pimpl->perf_shadow_buffers.emplace_back(std::move(host));
+        for (const auto & pair : pimpl->perf_shadow_pairs) {
+            ggml_backend_tensor_copy(pair.first, pair.second);
+            stats.weight_copy_bytes += ggml_nbytes(pair.first);
+        }
+    }
+    for (const auto & pair : pimpl->perf_shadow_pairs) {
+        stats.cpu_shadow_weight_bytes += ggml_nbytes(pair.first);
+        pair.first->buffer = pair.second->buffer;
+        pair.first->data = pair.second->data;
+        pair.first->extra = pair.second->extra;
+    }
+    // Preserve view identities while rebasing them to the CPU representation.
+    for (const auto & item : pimpl->ctxs_bufs) {
+        for (auto * t = ggml_get_first_tensor(item.first.get()); t; t = ggml_get_next_tensor(item.first.get(), t)) {
+            if (t->view_src && ggml_backend_buffer_is_host(t->view_src->buffer)) {
+                t->buffer = t->view_src->buffer; t->extra = nullptr;
+                t->data = (char *) t->view_src->data + t->view_offs;
+            }
+        }
+    }
+    if (drop_gpu) {
+        for (auto & item : pimpl->ctxs_bufs) {
+            auto & buffers = item.second;
+            buffers.erase(std::remove_if(buffers.begin(), buffers.end(), [&](const ggml_backend_buffer_ptr & buf) {
+                if (!perf_buffer_is_gpu(buf.get())) return false;
+                stats.gpu_weight_bytes_released += ggml_backend_buffer_get_size(buf.get());
+                return true;
+            }), buffers.end());
+        }
+    }
+    LLAMA_LOG_INFO("HYBRID: CPU weight references installed; readback %.2f MiB, shadow weights %.2f MiB, GPU weights released %.2f MiB\n",
+            stats.weight_copy_bytes/1048576.0, stats.cpu_shadow_weight_bytes/1048576.0, stats.gpu_weight_bytes_released/1048576.0);
+}
