+// Only canonical, host-resident model expert tensors. Repacked buffers,
+// biases, LoRA paths and unsupported layouts keep their original computation.
+static bool ggml_cpu_moe_cache_eligible(const ggml_tensor * node) {
+    if (node->op != GGML_OP_MUL_MAT_ID) return false;
+    const auto * w = node->src[0]; const auto * ids = node->src[2];
+    const char * suffix = strstr(w->name, ".ffn_");
+    return strncmp(w->name, "blk.", 4) == 0 && suffix && strstr(suffix, "_exps.weight") &&
+        w->buffer && ggml_backend_buffer_is_host(w->buffer) && !w->extra &&
+        !ggml_backend_cpu_is_extra_buffer_type(w->buffer->buft) &&
+        ggml_is_quantized(w->type) && ggml_is_contiguous(w) && w->ne[3] == 1 &&
+        w->ne[2] > 1 && ids->type == GGML_TYPE_I32 && ids->nb[0] == sizeof(int32_t) &&
+        ids->ne[2] == 1 && ids->ne[3] == 1 &&
+        ids->buffer && ggml_backend_buffer_is_host(ids->buffer);
+}
