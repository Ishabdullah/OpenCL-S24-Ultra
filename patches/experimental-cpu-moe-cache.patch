+static enum ggml_status ggml_backend_cpu_graph_compute(ggml_backend_t backend, struct ggml_cgraph * graph) {
+    auto * ctx = static_cast<ggml_backend_cpu_context *>(backend->context);
+    if (!ctx->moe_slots) return ggml_backend_cpu_graph_compute_plain(backend, graph);
+    int start = 0;
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        auto * node = graph->nodes[i];
+        if (!ggml_cpu_moe_cache_eligible(node)) continue;
+        // Execute all preceding nodes first: router IDs may be produced in
+        // this very CPU split. All calls here finish synchronously.
+        if (start < i) {
+            auto prefix = ggml_graph_view(graph, start, i);
+            auto status = ggml_backend_cpu_graph_compute_plain(backend, &prefix);
+            if (status != GGML_STATUS_SUCCESS) return status;
+        }
+        auto one = ggml_graph_view(graph, i, i + 1);
+        const auto * w = node->src[0]; const auto * ids = node->src[2];
+        std::vector<int32_t> original_ids(ggml_nelements(ids)), remapped;
+        for (int64_t row = 0; row < ids->ne[1]; ++row) {
+            memcpy(original_ids.data() + row * ids->ne[0],
+                static_cast<const char *>(ids->data) + row * ids->nb[1], ids->ne[0] * sizeof(int32_t));
+        }
+        moe_cache::entry * entry = nullptr;
+        try {
+            entry = ctx->moe_slots->prepare(w, w->data, w->nb[2], w->ne[2],
+                original_ids.data(), original_ids.size(), remapped);
+        } catch (const std::bad_alloc &) {
+            // Full-model fallback preserves correctness on allocation failure.
+        }
+        ggml_status status;
+        if (entry) {
+            ggml_tensor weights = *w, local_ids = *ids, local_node = *node;
+            weights.data = entry->bytes.data();
+            weights.ne[2] = entry->slots; weights.nb[3] = weights.nb[2] * weights.ne[2];
+            local_ids.data = remapped.data();
+            local_ids.nb[1] = local_ids.ne[0] * sizeof(int32_t);
+            local_ids.nb[2] = local_ids.nb[1] * local_ids.ne[1];
+            local_ids.nb[3] = local_ids.nb[2] * local_ids.ne[2];
+            local_node.src[0] = &weights; local_node.src[2] = &local_ids;
+            ggml_tensor * local_nodes[] = {&local_node}; one.nodes = local_nodes;
+            status = ggml_backend_cpu_graph_compute_plain(backend, &one);
+        } else {
+            status = ggml_backend_cpu_graph_compute_plain(backend, &one);
+        }
+        if (status != GGML_STATUS_SUCCESS) return status;
+        start = i + 1;
+    }
+    if (start < graph->n_nodes) {
+        auto tail = ggml_graph_view(graph, start, graph->n_nodes);
+        return ggml_backend_cpu_graph_compute_plain(backend, &tail);
+    }
+    return GGML_STATUS_SUCCESS;
 }
 
