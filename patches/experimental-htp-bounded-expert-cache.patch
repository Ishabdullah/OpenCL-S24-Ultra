+static bool ggml_hexagon_moe_cache_configure(ggml_hexagon_session * sess) {
+    auto & cache = sess->moe_weight_cache;
+    if (cache.configured) return cache.host_cache != nullptr;
+    cache.configured = true;
+    const char * slots_env = getenv("GGML_HEXAGON_MOE_EXPERT_CACHE_SLOTS");
+    if (!slots_env || !*slots_env) return false;
+    char * end = nullptr;
+    unsigned long slots = strtoul(slots_env, &end, 10);
+    if (end == slots_env || *end || slots == 0 || slots > 128) {
+        GGML_LOG_ERROR("ggml-hex: HTP expert cache slots must be in 1..128\n");
+        return false;
+    }
+    const char * mib_env = getenv("GGML_HEXAGON_MOE_EXPERT_CACHE_MAX_MIB");
+    unsigned long mib = mib_env && *mib_env ? strtoul(mib_env, &end, 10) : 512;
+    if ((mib_env && (end == mib_env || *end)) || mib == 0 || mib > 4096) {
+        GGML_LOG_ERROR("ggml-hex: HTP expert cache budget must be in 1..4096 MiB\n");
+        return false;
+    }
+    cache.slots = slots;
+    cache.device_limit = (size_t) mib * 1024 * 1024;
+    // The LRU object tracks slot ownership only. Expert bytes are copied
+    // directly from mmap to HTP below, avoiding a duplicate host cache.
+    cache.host_cache = std::make_unique<moe_cache::cache>(cache.slots, cache.device_limit, false);
+    GGML_LOG_INFO("ggml-hex: bounded routed-expert cache enabled slots=%zu device_budget_mib=%lu\n",
+                  cache.slots, mib);
+    return true;
+}
+
+static ggml_hexagon_moe_weight_cache_entry * ggml_hexagon_moe_cache_get_tensor(
+        ggml_hexagon_session * sess, const ggml_tensor * source, const ggml_tensor * ids) {
+    auto & state = sess->moe_weight_cache;
+    auto found = state.tensors.find(source);
+    if (found != state.tensors.end()) {
+        auto * entry = found->second.get();
+        if (entry->compact_ids && ggml_are_same_shape(entry->compact_ids, ids)) return entry;
+        if (entry->ids_buffer) ggml_backend_buffer_free(entry->ids_buffer);
+        if (entry->ids_ctx) ggml_free(entry->ids_ctx);
+        entry->ids_buffer = nullptr;
+        entry->ids_ctx = nullptr;
+        entry->compact_ids = nullptr;
+    }
+    ggml_hexagon_moe_weight_cache_entry * entry;
+    if (found == state.tensors.end()) {
+        if (!ggml_is_contiguous(source) || source->ne[2] <= 0 || source->ne[3] != 1 ||
+            source->nb[2] == 0 || source->nb[2] * (size_t) state.slots > SIZE_MAX) {
+            GGML_LOG_ERROR("ggml-hex: invalid source layout for HTP expert cache tensor %s\n", source->name);
+            return nullptr;
+        }
+        std::unique_ptr<ggml_hexagon_moe_weight_cache_entry> created(new ggml_hexagon_moe_weight_cache_entry());
+        created->expert_bytes = source->nb[2];
+        ggml_init_params params = { 4 * ggml_tensor_overhead() + 4096, nullptr, true };
+        created->weight_ctx = ggml_init(params);
+        if (!created->weight_ctx) return nullptr;
+        created->compact_weights = ggml_new_tensor_3d(created->weight_ctx, source->type,
+                source->ne[0], source->ne[1], state.slots);
+        if (!created->compact_weights) return nullptr;
+        ggml_format_name(created->compact_weights, "htp-cache-%s", source->name);
+        const size_t alloc_size = ggml_backend_alloc_ctx_tensors_from_buft_size(
+                created->weight_ctx, &sess->dev_ctx->buffer_type);
+        if (alloc_size == 0 || alloc_size > state.device_limit - state.device_allocated) {
+            GGML_LOG_ERROR("ggml-hex: HTP expert cache budget refused %s (%zu bytes; %zu/%zu used)\n",
+                    source->name, alloc_size, state.device_allocated, state.device_limit);
+            return nullptr;
+        }
+        created->weight_buffer = ggml_backend_alloc_ctx_tensors_from_buft(
+                created->weight_ctx, &sess->dev_ctx->buffer_type);
+        if (!created->weight_buffer) return nullptr;
+        ggml_backend_buffer_set_usage(created->weight_buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        auto * extra = (ggml_hexagon_tensor_extra *) created->compact_weights->extra;
+        extra->flags |= GGML_HEXAGON_TENSOR_REPACK | GGML_HEXAGON_TENSOR_WEIGHT;
+        created->device_bytes = alloc_size;
+        created->repacked_expert_bytes = alloc_size / state.slots;
+        state.device_allocated += alloc_size;
+        auto inserted = state.tensors.emplace(source, std::move(created));
+        found = inserted.first;
+        GGML_LOG_INFO("ggml-hex: HTP expert cache allocated %s %zu slots, %zu bytes\n",
+                source->name, state.slots, alloc_size);
+    }
+    entry = found->second.get();
+    ggml_init_params id_params = { 2 * ggml_tensor_overhead() + 2048, nullptr, true };
+    entry->ids_ctx = ggml_init(id_params);
+    if (!entry->ids_ctx) return nullptr;
+    entry->compact_ids = ggml_dup_tensor(entry->ids_ctx, ids);
+    if (!entry->compact_ids) return nullptr;
+    ggml_format_name(entry->compact_ids, "htp-cache-ids-%s", source->name);
+    entry->ids_buffer = ggml_backend_alloc_ctx_tensors_from_buft(entry->ids_ctx, &sess->dev_ctx->buffer_type);
+    if (!entry->ids_buffer) return nullptr;
+    ggml_backend_buffer_set_usage(entry->ids_buffer, GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+    return entry;
+}
+
+static bool ggml_hexagon_moe_cache_stage(ggml_hexagon_session * sess, ggml_tensor * node,
+                                         ggml_tensor & staged_node, htp_opnode & staged,
+                                         std::vector<int32_t> & remapped) {
+    if (!ggml_hexagon_moe_cache_configure(sess)) return false;
+    ggml_tensor * weights = node->src[0];
+    ggml_tensor * ids_tensor = node->src[2];
+    if (!weights || !ids_tensor || ids_tensor->type != GGML_TYPE_I32 ||
+        !ggml_is_contiguous(ids_tensor) || weights->ne[2] <= 0 || weights->ne[3] != 1) {
+        GGML_LOG_ERROR("ggml-hex: unsupported HTP expert-cache input for %s\n", node->name);
+        return false;
+    }
+    sess->flush_sync();
+    const size_t n_ids = ggml_nelements(ids_tensor);
+    std::vector<int32_t> ids(n_ids);
+    ggml_backend_tensor_get(ids_tensor, ids.data(), 0, n_ids * sizeof(int32_t));
+    auto * cached = sess->moe_weight_cache.host_cache->prepare(weights, weights->data,
+            weights->nb[2], (int) weights->ne[2], ids.data(), ids.size(), remapped);
+    if (!cached) {
+        GGML_LOG_ERROR("ggml-hex: HTP expert cache cannot fit selected routes for %s\n", weights->name);
+        return false;
+    }
+    auto * buffer = ggml_hexagon_moe_cache_get_tensor(sess, weights, ids_tensor);
+    if (!buffer) return false;
+
+    const size_t staged_bytes_before = sess->moe_weight_cache.staged_bytes;
+    std::vector<uint8_t> expert(buffer->expert_bytes);
+    for (int slot : cached->changed_slots) {
+        const int expert_id = cached->owner[slot];
+        ggml_backend_tensor_get(weights, expert.data(), (size_t) expert_id * buffer->expert_bytes,
+                                buffer->expert_bytes);
+        sess->moe_weight_cache.staged_bytes += buffer->expert_bytes;
+        ggml_tensor view = *buffer->compact_weights;
+        view.ne[2] = 1;
+        view.ne[3] = 1;
+        view.data = (uint8_t *) buffer->compact_weights->data + (size_t) slot * buffer->repacked_expert_bytes;
+        view.extra = buffer->compact_weights->extra;
+        repack_tensor_tiled(&view, expert.data(), expert.size());
+    }
+    ggml_backend_tensor_set(buffer->compact_ids, remapped.data(), 0, remapped.size() * sizeof(int32_t));
+    GGML_LOG_INFO("ggml-hex: bounded HTP cache staged tensor=%s routed_ids=%zu loaded_slots=%zu bytes=%zu\n",
+            weights->name, ids.size(), cached->changed_slots.size(),
+            sess->moe_weight_cache.staged_bytes - staged_bytes_before);
+
+    staged_node = *node;
+    staged_node.src[0] = buffer->compact_weights;
+    staged_node.src[2] = buffer->compact_ids;
+    staged.init(&staged_node);
+    staged.opcode = HTP_OP_MUL_MAT_ID;
+    ggml_hexagon_precompute_matmul_params(sess, staged_node.src[0], staged_node.src[1],
+            &staged_node, (struct htp_mm_kernel_params *) staged.kernel_params);
+    return true;
+}
